# Template konfigurasi Supabase untuk StockWise.
# Untuk database lokal (Docker Compose development), gunakan development.env.example.
#
# Langkah:
# 1. Salin berkas ini menjadi supabase.env pada direktori yang sama.
#    Berkas supabase.env otomatis diabaikan oleh git (*.env).
# 2. Buka Supabase Dashboard -> Connect -> Session pooler.
# 3. Salin host, user, dan database persis dari dashboard; isi password database.
# 4. Jangan pernah meng-commit supabase.env atau membagikan password database.
#
# Catatan: Session pooler memakai database "postgres" (Supabase tidak mendukung
# nama database kustom pada pooler).

APP_ENV=development

# Session pooler Supabase (IPv4, port 5432).
POSTGRES_USER=postgres.<project-ref>
POSTGRES_PASSWORD=<database-password>
POSTGRES_DB=postgres
POSTGRES_HOST=<session-pooler-host-dari-dashboard>
POSTGRES_PORT=5432
DATABASE_SSL=true

# Pool kecil agar tidak menghabiskan kuota koneksi Supabase.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# Opsional: override URL penuh (misalnya dari platform PaaS).
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<host>:5432/postgres?ssl=require
# Opsional: URL khusus migrasi Alembic (direct/session pooler).
# MIGRATION_DATABASE_URL=

JWT_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter
CORS_ORIGINS=http://localhost:5173

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_DEFAULT=60/minute
