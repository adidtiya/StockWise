# Salin file ini menjadi .env (file .env tidak ikut ke GitHub), lalu isi nilainya.

# Connection string PostgreSQL. Dari Neon: Dashboard > project > Connect > salin "Connection string".
# Contoh bentuknya: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=

# Opsional di komputer sendiri (dibuat otomatis di folder data/). WAJIB diisi di server publik:
# string acak panjang, mis. hasil perintah: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
